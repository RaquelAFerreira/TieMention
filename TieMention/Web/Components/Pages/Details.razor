@rendermode InteractiveServer
@page "/Details/{id:guid}"
@inject HttpClient http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Headers
@inject NavigationManager Navigation
@inject PieceService PieceService


<PageTitle>Details</PageTitle>

<div class="container">
    <SearchBar/>

@if (@PieceService.PieceDetails == null)
{
    <p>Carregando...</p>
}
else
{   
    <div>    
        @* <MainTitle Title="@TitleName"/> *@
        <MainTitle Title="@PieceService.PieceDetails.Name"/>
    </div>

    <div class="main-content">
        <BlockText Head="@HeadText" Text="@PieceService.PieceDetails.Description"/>
        <AnalogImage Image="https://static1.colliderimages.com/wordpress/wp-content/uploads/2024/02/the-matrix-code-keanu-reeves.jpg"/>
    </div>
    
    <div>
        <MentionsSection/>
    </div>
}

</div>

@code {
    
    private String? HeadText = "Movie \r\n 1999 \r\n United States";

    private String? TitleName;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PieceService.ApiResponse += StateHasChanged;

        if (PieceService.PieceDetails == null)
        {
            PieceService.PieceDetails = await PieceService.GetPieceAsync(Id);
        }
    }
}