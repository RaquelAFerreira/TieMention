@rendermode InteractiveServer
@inject HttpClient Http


@page "/Piece/Create"

<div class="container">
    <SearchBar/>

    <div>    
        <MainTitle Title="Create Piece"/>
    </div>

    <FormCreate 
        OnSubmit="HandleFormSubmit"
        @ref="formCreateComponent"/>
</div>



@code {
    private FormCreate? formCreateComponent;
    
    private async Task HandleFormSubmit(FormModel content)
    {
        try
        {
            // Call your API endpoint here
            var response = await Http.PostAsJsonAsync("api/piece", content);
            
            if (response.IsSuccessStatusCode)
            {
                // Handle success
                if (formCreateComponent != null)
                {
                    await formCreateComponent.ShowSuccessModal();
                }
            }
            else
            {
                // Handle error
                Console.WriteLine($"Error: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex.Message}");
        }
    }
}