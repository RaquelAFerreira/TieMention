@rendermode InteractiveServer

@page "/Piece/Create"

<div class="container">
    <SearchBar/>

    <div>    
        <MainTitle Title="Create Piece"/>
    </div>

        <FormCreate Category="@GetCategory" Description="@GetDescription" Image="@GetImage"/>
</div>



@code {
    
    public string? Category { get; set; }

    public string? Description { get; set; }

    public string? Image { get; set; }

    private void GetImage(string content)
    {
        Image = content;
    }

    private void GetDescription(string content)
    {
        Description = content;
    }

        private void GetCategory(string content)
    {
        Category = content;
    }

}