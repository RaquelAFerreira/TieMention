@page "/Mention/{Slug}"
<PageTitle>Mention</PageTitle>
@inject NavigationManager Navigation
@inject PieceService PieceService
@inject MentionService MentionService

<div class="container">
    <SearchBar/>

    <div>    
        <MainTitle Title="Barbie mentions Matrix"/>
    </div>

    <div class="main-content">
        <BlockText Head="@HeadText" Text="@BodyText"/>
        <AnalogImage Image="https://i.insider.com/64c1171a671ed600191563b5?width=600&format=jpeg&auto=webp"/>
    </div>
    
    <div>
        <RelationSection/>
    </div>

</div>

@code {
    
    private String? HeadText;

    private String? BodyText;
    private MentionDetailsDto? MentionDetails;

    [Parameter]
    public string Slug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PieceService.ApiResponse += StateHasChanged;

        if (PieceService.MentionPiece == null)
        {
            MentionDetails = await MentionService.GetMentionAsync(new Guid(), Slug);
        }
        else
        {
            MentionDetails = await MentionService.GetMentionAsync(PieceService.MentionPiece.IdMention);
        }

        HeadText = "Categories: " + MentionDetails.MentionerPiece.Category + " and " + MentionDetails.MentionedPiece.Category + "\r\n"
                 + "Release Years: " + MentionDetails.MentionerPiece.ReleaseYear + " and " + MentionDetails.MentionedPiece.ReleaseYear;

        BodyText = MentionDetails.Description;
    }
}