@rendermode InteractiveServer
@page "/Piece/{slug}"
@inject HttpClient http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Headers
@inject NavigationManager Navigation
@inject PieceService PieceService


<PageTitle>Piece</PageTitle>

<div class="container">
    <SearchBar/>

@if (@PieceService.PieceDetails == null)
{
    <p>Loading...</p>
}
else
{   
    <div>    
        <MainTitle Title="@PieceService.PieceDetails.Name"/>
    </div>

    <div class="main-content">
        <BlockText Head="@HeadText" Text="@PieceService.PieceDetails.Description"/>
        <AnalogImage 
            Image="@PieceService.PieceDetails.Image"
            MentionedPieceId="@PieceService.PieceDetails.Id"
            MentionedPieceName="@PieceService.PieceDetails.Name"/>
    </div>
    @if (Mentioners != null && Mentioners.Count != 0)
    {
        <div>
            <MentionsSection Head="Mentioned By" Content="@Mentioners"/>
        </div>        
    }
    @if (Mentioneds != null && Mentioneds.Count != 0)
    {
        <div>
            <MentionsSection Head="Mentions" Content="@Mentioneds"/>
        </div>
    }

}

</div>

@code {
    
    private String? HeadText;

    [Parameter]
    public String Slug { get; set; }

    public List<PieceMentionsDto?> Mentioners { get; set; }

    public List<PieceMentionsDto?> Mentioneds { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PieceService.ApiResponse += StateHasChanged;

        if (PieceService.PieceDetails == null)
        {
            PieceService.GetCurrentPieceDetails(await PieceService.GetPieceAsync(Slug));
        }

        Mentioners = await PieceService.GetMentionerPiecesAsync(PieceService.PieceDetails.Id);
        Mentioneds = await PieceService.GetMentionedPiecesAsync(PieceService.PieceDetails.Id);

        HeadText = "Category: " + PieceService.PieceDetails.Category + "\r\n" + "Release Year: " + PieceService.PieceDetails.ReleaseYear;
    }
}
