@rendermode InteractiveServer
@page "/Piece/{slug}"
@inject HttpClient http
@inject IJSRuntime JSRuntime
@using System.Net.Http.Headers
@inject NavigationManager Navigation
@inject PieceService PieceService


<PageTitle>Piece</PageTitle>

<div class="container">
    <SearchBar/>

@if (@PieceService.PieceDetails == null)
{
    <p>Carregando...</p>
}
else
{   
    <div>    
        <MainTitle Title="@PieceService.PieceDetails.Name"/>
    </div>

    <div class="main-content">
        <BlockText Head="@HeadText" Text="@PieceService.PieceDetails.Description"/>
        <AnalogImage Image="@PieceService.PieceDetails.Image"/>
    </div>
    
    <div>
        <MentionsSection Head="Mentioned By" Content="@Mentioners"/>
    </div>
}

</div>

@code {
    
    private String? HeadText;

    [Parameter]
    public String Slug { get; set; }

    public List<PieceMentionsDto?> Mentioners { get; set; }

    protected override async Task OnInitializedAsync()
    {
        PieceService.ApiResponse += StateHasChanged;

        if (PieceService.PieceDetails == null)
        {
            PieceService.PieceDetails = await PieceService.GetPieceAsync(Slug);
        }

        Mentioners = await PieceService.GetMentionerPiecesAsync(PieceService.PieceDetails.Id);

        HeadText = "Category: " + PieceService.PieceDetails.Category + "\r\n" + "Release Year: " + PieceService.PieceDetails.ReleaseYear;
    }
}