<div class="text-content">
    <form @onsubmit="HandleSubmit">
        <div class="text-block preserve-line-breaks">
            <div class="green-bar"></div>
            <div class="text-section">
                <div class="form-group">
                    <select @bind="categoryValue" class="form-control" style="background-color: black; border: 1px solid #333;">
                        <option value="">Category</option>
                        <option value="Movie">Movie</option>
                        <option value="TV Show">TV Show</option>
                        <option value="Documentary">Documentary</option>
                        <option value="Animation">Animation</option>
                        <option value="Short Film">Short Film</option>
                    </select>
                </div>
                <div class="form-group">
                    <select @bind="releaseYearValue" class="form-control" style="background-color: black; border: 1px solid #333;">
                        <option value="">Release Year</option>
                        @foreach (var year in availableYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="text-block">
            <div class="green-bar tall"></div>
            <div class="text-section tall">
                <div class="form-group description-group">
                    <label>Description:</label>
                    <textarea @bind="descriptionValue" class="form-control description-input"></textarea>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

@code {
    private string categoryValue;
    private string releaseYearValue;
    private string descriptionValue;
    private List<int> availableYears = new List<int>();

    [Parameter]
    public EventCallback<string?> Category { get; set; }

    [Parameter]
    public EventCallback<string?> ReleaseYear { get; set; }

    [Parameter]
    public EventCallback<string?> Description { get; set; }

    private async Task HandleSubmit()
    {
        await Category.InvokeAsync(categoryValue);
        await ReleaseYear.InvokeAsync(releaseYearValue);
        await Description.InvokeAsync(descriptionValue);
    }

    protected override void OnInitialized()
    {
        int currentYear = DateTime.Now.Year;
        for (int year = currentYear; year >= currentYear - 120; year--)
        {
            availableYears.Add(year);
        }
    }
}