@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject PieceService PieceService

<div class="mentions-section">            
    <div class="mentions-title">Relation</div>
    <div class="relation-container">
        <div class="slides-wrapper" id="slidesWrapper">
            <div class="slide" @onclick="(() => NavigateToDetails(Content.MentionerPiece.Slug))">
                <img src="@Content.MentionerPiece.Image" alt="Imagem" class="slide-image" />
                <div class="slide-title">@Content.MentionerPiece.Name (@Content.MentionerPiece.ReleaseYear)</div>
            </div>
            <div class="slide" @onclick="(() => NavigateToDetails(Content.MentionedPiece.Slug))">
                <img src="@Content.MentionedPiece.Image" alt="Imagem" class="slide-image" />
                <div class="slide-title">@Content.MentionedPiece.Name (@Content.MentionedPiece.ReleaseYear)</div>
            </div>
        </div>
    </div>
</div>


@code {

    [Parameter]
    public MentionDetailsDto? Content { get; set; }

    private void NavigateToDetails(String Slug)
    {
        PieceService.PieceDetails = null;
        NavigationManager.NavigateTo($"Piece/{Slug}");
    }
}
