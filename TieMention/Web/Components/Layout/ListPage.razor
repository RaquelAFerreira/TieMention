@rendermode InteractiveServer
@using TieMention.Services
@inject PieceService PieceService
@inject NavigationManager NavigationManager

<SearchBar/>

@if (Response?.Items == null)
{
    <p class="text-light">Loading...</p>
}
else if (!Response.Items.Any())
{
    <p class="text-light">No Pieces found.</p>
}
else
{
    <div class="card-container">
        @foreach (var piece in Response.Items)
        {
            <div class="neon-card" @onclick="(() => PieceService.GetCurrentPieceDetails(NavigateToDetails(piece)))" style="cursor: pointer;">
                <img src="@piece.Image" alt="Piece image" class="piece-image" />
                <div class="card-content">
                    <h5 class="text-neon"><b>@piece.Name (@piece.ReleaseYear)</b></h5>
                    <p class="text-muted"><b>@piece.Category</b></p>
                    <p class="text-muted">@TruncateDescription(piece.Description)</p>
                </div>
            </div>
        }
    </div>
    
    <div class="pagination-container">
        <button 
            class="btn-neon pagination-btn" 
            disabled="@(_currentPage <= 1)" 
            @onclick="(() => ChangePage(_currentPage - 1))">
            ← Previous
        </button>

        <span class="page-indicator">Page @_currentPage of @Response?.TotalPages</span>

        <button 
            class="btn-neon pagination-btn" 
            disabled="@(_currentPage >= Response?.TotalPages)" 
            @onclick="(() => ChangePage(_currentPage + 1))">
            Next →
        </button>
    </div>
}

@code {
    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;
    private int _currentPage = 1;
    private const int PageSize = 2;
    
    private PieceListResponse<PieceListDto>? Response { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadPieces();
    }

    private string TruncateDescription(string description, int maxLength = 200)
    {
        if (string.IsNullOrEmpty(description)) return description;
        return description.Length > maxLength ? description.Substring(0, maxLength) + "..." : description;
    }

    private async Task LoadPieces()
    {
        Response = await PieceService.GetPiecesAsync(SearchTerm, _currentPage, PageSize);
    }

    private async Task ChangePage(int newPage)
    {
        _currentPage = newPage;
        await LoadPieces();
    }

    private PieceListDto NavigateToDetails(PieceListDto piece)
    {
        NavigationManager.NavigateTo($"Piece/{piece.Slug}");
        return piece;
    }

    private void ResponseReturn(PieceListResponse<PieceListDto> responseReturn)
    {
       Response = responseReturn;
    }
}