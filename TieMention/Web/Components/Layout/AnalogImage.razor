@inject NavigationManager Navigation

<div class="main-container">
    <div class="image-container">
        <div class="image-border outer"></div>
        <div class="image-border inner"></div>
        <img src="@Image" class="main-image">
    </div> 
    
    <div class="analog-button-container">
        <button class="analog-button" @onclick="CreateMention">+</button>
        <button class="analog-button">-</button>
        <button class="analog-button">:</button>
        <button class="analog-button">:</button>
        <button class="analog-button">:</button>
    </div>
</div>


@code {
    [Parameter]
    public String? Image {get; set;}

    [Parameter]
    public Guid? MentionedPieceId { get; set; }

    [Parameter]
    public string? MentionedPieceName { get; set; }

    private void CreateMention()
    {
        if (MentionedPieceId is null)
        {
            Navigation.NavigateTo("Mention/Create");
            return;
        }

        var url = $"Mention/Create?mentionedPieceId={MentionedPieceId}";

        if (!string.IsNullOrWhiteSpace(MentionedPieceName))
        {
            url += $"&mentionedPieceName={Uri.EscapeDataString(MentionedPieceName)}";
        }

        Navigation.NavigateTo(url);
    }
}
