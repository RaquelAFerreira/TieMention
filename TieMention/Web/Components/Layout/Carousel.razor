@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject PieceService PieceService

@code {

    [Parameter]
    public List<PieceMentionsDto?> Content { get; set; }

    private void NavigateToDetails(PieceMentionsDto pieceMention)
    {
        NavigationManager.NavigateTo($"Mention/{pieceMention.MentionSlug}");
    }
}

@if (Content == null)
{
    <p class="text-light">Loading...</p>
}
else
{
    <div class="carousel-container">
        <div class="slides-wrapper" id="slidesWrapper">
            @foreach (var item in Content)
            {
                <div class="slide" @onclick="(() => NavigateToDetails(item))">
                    <img src="@item.Image" alt="Imagem" class="slide-image" />
                    <div class="slide-title">@item.Name (@item.ReleaseYear)</div>
                </div>
            }
        </div>

        <button class="carousel-button prev">&#10094;</button>
        <button class="carousel-button next">&#10095;</button>
    </div>
}
<script>
(function () {
    const wrapper = document.getElementById('slidesWrapper');
    const slides = wrapper.querySelectorAll('.slide');
    let currentIndex = 0;

    function getSlidesPerView() {
        const width = window.innerWidth;
        if (width >= 1640) return 5;
        if (width >= 1420) return 4;
        if (width >= 1010) return 3;
        if (width >= 400) return 2;
        return 1;
    }

    function updateCarousel() {
        const slidesPerView = getSlidesPerView();
        const slideWidth = 100 / slidesPerView;
        const maxIndex = Math.max(slides.length - slidesPerView, 0);
        
        // Ajusta o currentIndex se necessário
        currentIndex = Math.min(currentIndex, maxIndex);
        
        // Define a largura dos slides
        slides.forEach(slide => {
            slide.style.flex = `0 0 ${slideWidth}%`;
        });
        
        // Calcula o deslocamento
        const offset = currentIndex * slideWidth;
        wrapper.style.transform = `translateX(-${offset}%)`;
    }

    function nextSlide() {
        const slidesPerView = getSlidesPerView();
        const maxIndex = Math.max(slides.length - slidesPerView, 0);
        currentIndex = (currentIndex + 1) > maxIndex ? 0 : currentIndex + 1;
        updateCarousel();
    }

    function prevSlide() {
        const slidesPerView = getSlidesPerView();
        const maxIndex = Math.max(slides.length - slidesPerView, 0);
        currentIndex = (currentIndex - 1) < 0 ? maxIndex : currentIndex - 1;
        updateCarousel();
    }

    document.querySelector('.next').addEventListener('click', nextSlide);
    document.querySelector('.prev').addEventListener('click', prevSlide);

    window.addEventListener('resize', updateCarousel);
    window.addEventListener('load', updateCarousel);
    
    // Inicializa o carrossel
    updateCarousel();
})();
</script>