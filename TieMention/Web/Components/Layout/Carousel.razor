@{
    var imagens = new List<(string Url, int Id)> {
        ("https://pixcap.com/cdn/blog/uploads/large_ur_Pk_DQEF_3eyll_M_Oi16_Kk3ibw_N8k_a96580ac71.webp", 1),
        ("https://static.vecteezy.com/system/resources/previews/027/653/928/non_2x/barbie-pink-vintage-logo-illustration-free-vector.jpg", 2),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 3),
        ("https://pixcap.com/cdn/blog/uploads/large_ur_Pk_DQEF_3eyll_M_Oi16_Kk3ibw_N8k_a96580ac71.webp", 4),
        ("https://static.vecteezy.com/system/resources/previews/027/653/928/non_2x/barbie-pink-vintage-logo-illustration-free-vector.jpg", 5),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
        ("https://framerusercontent.com/images/1mhs90nwXk38DYDbSqCMKcnM.png", 6),
    };
}

<div class="carousel-container">
    <div class="slides-wrapper" id="slidesWrapper">
        @foreach (var item in imagens)
        {
            <div class="slide" onclick="navigateToDetails(@item.Id)">
                <img src="@item.Url" alt="Imagem" class="slide-image" />
                <div class="slide-title">Barbie (2024)</div>
            </div>
        }
    </div>

    <button class="carousel-button prev">&#10094;</button>
    <button class="carousel-button next">&#10095;</button>
</div>

<script>
(function () {
    // Cache de elementos
    const wrapper = document.getElementById('slidesWrapper');
    const slides = Array.from(wrapper.querySelectorAll('.slide'));
    const nextBtn = document.querySelector('.next');
    const prevBtn = document.querySelector('.prev');
    let currentIndex = 0;
    let slidesPerView = 0;
    let resizeTimeout;

    // Configurações ajustáveis
    const config = {
        responsiveBreakpoints: [
            { minWidth: 1640, slides: 5 },
            { minWidth: 1420, slides: 4 },
            { minWidth: 1010, slides: 3 },
            { minWidth: 400, slides: 2 },
            { minWidth: 0, slides: 1 }
        ],
        transitionDuration: '0.5s',
        autoSlideInterval: null // Pode definir um valor em ms para slides automáticos
    };

    // Função para navegar para os detalhes
    const navigateToDetails = (id) => {
        window.location.href = `/mention/${id}`;
    };

    // Calcula quantos slides são visíveis
    const calculateSlidesPerView = () => {
        const width = window.innerWidth;
        const breakpoint = config.responsiveBreakpoints.find(bp => width >= bp.minWidth);
        return breakpoint ? breakpoint.slides : 1;
    };

    // Atualiza o carrossel
    const updateCarousel = () => {
        slidesPerView = calculateSlidesPerView();
        const maxIndex = Math.max(slides.length - slidesPerView, 0);
        
        // Corrige currentIndex se necessário
        currentIndex = Math.min(Math.max(currentIndex, 0), maxIndex);
        
        // Aplica estilos e transformação
        wrapper.style.transitionDuration = config.transitionDuration;
        const slideWidth = 100 / slidesPerView;
        const offset = currentIndex * slideWidth;
        
        slides.forEach(slide => {
            slide.style.flex = `0 0 ${slideWidth}%`;
            slide.style.maxWidth = `${slideWidth}%`;
        });
        
        wrapper.style.transform = `translateX(-${offset}%)`;
        
        // Atualiza estado dos botões
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex >= maxIndex;
    };

    // Navegação
    const goToSlide = (index) => {
        currentIndex = index;
        updateCarousel();
    };

    const nextSlide = () => {
        const maxIndex = Math.max(slides.length - slidesPerView, 0);
        goToSlide(currentIndex < maxIndex ? currentIndex + 1 : 0);
    };

    const prevSlide = () => {
        const maxIndex = Math.max(slides.length - slidesPerView, 0);
        goToSlide(currentIndex > 0 ? currentIndex - 1 : maxIndex);
    };

    // Event Listeners com debounce para resize
    const handleResize = () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
            updateCarousel();
        }, 100);
    };

    // Inicialização
    const init = () => {
        // Event listeners
        nextBtn.addEventListener('click', nextSlide);
        prevBtn.addEventListener('click', prevSlide);
        window.addEventListener('resize', handleResize);
        
        // Toque para dispositivos móveis
        let touchStartX = 0;
        let touchEndX = 0;
        
        wrapper.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        wrapper.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        }, { passive: true });
        
        const handleSwipe = () => {
            if (touchStartX - touchEndX > 50) nextSlide(); // Swipe left
            if (touchEndX - touchStartX > 50) prevSlide(); // Swipe right
        };
        
        // Auto slide (opcional)
        if (config.autoSlideInterval) {
            setInterval(nextSlide, config.autoSlideInterval);
        }
        
        // Inicializa
        updateCarousel();
    };

    // Disponibiliza funções globalmente se necessário
    window.Carousel = {
        next: nextSlide,
        prev: prevSlide,
        goTo: goToSlide,
        update: updateCarousel
    };

    // Inicia o carrossel
    document.addEventListener('DOMContentLoaded', init);
})();
</script>