@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject PieceService PieceService

@code {
    [Parameter]
    public List<PieceMentionsDto?> Content { get; set; }

    private async Task NavigateToDetails(PieceMentionsDto pieceMention)
    {
        NavigationManager.NavigateTo($"Mention/{pieceMention.MentionSlug}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Content != null)
        {
            await JSRuntime.InvokeVoidAsync("initializeCarousel", Content.Count);
        }
    }

    private string TruncateDescription(string description, int maxLength = 18)
    {
        if (string.IsNullOrEmpty(description)) return description;
        return description.Length > maxLength ? description.Substring(0, maxLength) + "..." : description;
    }
}

<div class="carousel-container">
    <div class="slides-wrapper" id="slidesWrapper">
        @foreach (var item in Content)
        {
            <div class="slide" @onclick="(() => NavigateToDetails(item))">
                <div class="image-container">
                    <img src="@item.Image" alt="@item.Name" class="slide-image" />
                </div>
                <div class="slide-title">@TruncateDescription(item.Name) (@item.ReleaseYear)</div>
            </div>
        }
    </div>

    <button class="carousel-button prev" id="prevButton">&#10094;</button>
    <button class="carousel-button next" id="nextButton">&#10095;</button>
</div>

<script>
(function () {
    let currentIndex = 0;
    let slidesPerView = 5;

    function initializeCarousel(itemCount) {
        const wrapper = document.getElementById('slidesWrapper');
        const slides = wrapper?.querySelectorAll('.slide');
        const prevButton = document.getElementById('prevButton');
        const nextButton = document.getElementById('nextButton');

        if (!wrapper || !slides) return;

        function updateCarousel() {
            // Calcula quantos slides são necessários
            slidesPerView = getSlidesPerView();
            const slideWidth = 100 / slidesPerView;
            const maxIndex = Math.max(slides.length - slidesPerView, 0);
            
            currentIndex = Math.min(currentIndex, maxIndex);
            
            // Ajusta a largura dos slides
            slides.forEach(slide => {
                slide.style.flex = `0 0 ${slideWidth}%`;
            });
            
            // Move o carrossel
            const offset = currentIndex * slideWidth;
            wrapper.style.transform = `translateX(-${offset}%)`;
            
            // Mostra/esconde botões
            const shouldShowButtons = itemCount > slidesPerView;
            prevButton.style.display = shouldShowButtons ? 'block' : 'none';
            nextButton.style.display = shouldShowButtons ? 'block' : 'none';
        }

        function getSlidesPerView() {
            const width = window.innerWidth;
            if (width >= 1640) return 5;
            if (width >= 1320) return 4;
            if (width >= 1010) return 3;
            if (width >= 680) return 2;
            return 1;
        }

        function nextSlide() {
            const maxIndex = Math.max(slides.length - slidesPerView, 0);
            currentIndex = (currentIndex + 1) > maxIndex ? 0 : currentIndex + 1;
            updateCarousel();
        }

        function prevSlide() {
            const maxIndex = Math.max(slides.length - slidesPerView, 0);
            currentIndex = (currentIndex - 1) < 0 ? maxIndex : currentIndex - 1;
            updateCarousel();
        }

        // Configura eventos
        nextButton.addEventListener('click', nextSlide);
        prevButton.addEventListener('click', prevSlide);
        window.addEventListener('resize', updateCarousel);

        // Inicializa
        updateCarousel();
    }

    window.initializeCarousel = initializeCarousel;
})();
</script>
