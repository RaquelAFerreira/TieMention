@rendermode InteractiveServer

<EditForm Model="@formModel" OnValidSubmit="HandleSubmit" FormName="mention-form">
    <div class="main-content">
        <div class="text-content">
            <div class="text-block preserve-line-breaks">
                <div class="green-bar"></div>
                <div class="text-section">
                    <div class="form-group">
                        <InputSelect @bind-Value="formModel.MentionerPiece" class="form-control" style="background-color: black; border: 1px solid #333;">
                            <option value="">Mentioner Piece</option>
                            @if (MentionerPieces != null)
                            {
                                @foreach (var mentionerPiece in MentionerPieces)
                                {
                                    <option value="@mentionerPiece?.Id">@mentionerPiece?.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="text-block">
                <div class="green-bar tall"></div>
                <div class="text-section tall">
                    <div class="form-group description-group">
                        <label>Description:</label>
                        <InputTextArea @bind-Value="formModel.Description" class="form-control description-input" style="height: 290px; background-color: black; border: 1px solid #74a814;" />
                    </div>
                </div>
            </div>
        </div>

        <div class="main-container">
            <div class="image-container">
                <div class="image-border outer"></div>
                <div class="image-border inner"></div>
                @* <img src="@formModel.Image" class="main-image"> *@
            </div> 
            
            <div class="analog-button-container">
                <button type="button" class="analog-button">+</button>
                <button type="button" class="analog-button">-</button>
            </div>        
            <InputTextArea @bind-Value="formModel.Image" class="form-control name-input"  style="background-color: black; border: 1px solid #74a814;" />
        </div>
    </div>

    <div class="button-container">
        <button type="submit" class="btn-submit">Submit</button>
    </div>
</EditForm>

@if (isModalVisible)
{
    <div class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50">
        <div class="bg-black border-2 border-[#74a814] rounded-xl shadow-neon p-6 w-full max-w-sm font-mono text-[#74a814]">
            <h2 class="text-2xl font-bold mb-4 drop-shadow-neon">⚡ Piece Created ⚡</h2>
            <p class="mb-6">The Piece will be approved by our staff</p>
            <button class="bg-[#74a814] text-black px-5 py-2 rounded shadow-neon hover:brightness-125 transition"
                    @onclick="() => isModalVisible = false">
                OK
            </button>
        </div>
    </div>
}

@code {
    private FormMentionModel formModel = new();
    private bool isModalVisible;

    private List<PieceComboboxDto?> MentionerPieces = new();

    [Parameter] 
    public EventCallback<FormMentionModel> OnSubmit { get; set; }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(formModel);
    }

    public async Task ShowSuccessModal()
    {
        isModalVisible = true;
        StateHasChanged();
        
        await Task.Delay(3000);
        isModalVisible = false;
        formModel = new();
        StateHasChanged();
    }
}