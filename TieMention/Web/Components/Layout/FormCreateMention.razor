@rendermode InteractiveServer
@inject MentionService MentionService

@inject IJSRuntime JSRuntime


<EditForm Model="@formModel" OnValidSubmit="HandleSubmit" FormName="mention-form">
    <div class="main-content">
        <div class="text-content">
            <div class="text-block preserve-line-breaks">
                <div class="green-bar"></div>
                <div class="text-section" style="overflow: visible;">
                    <div class="form-group">
                        <label>Mentioner Piece:</label>
                        <div class="combobox-container">
                            <input type="text" 
                                   class="form-control" 
                                   style="background-color: black; border: 1px solid #333;"
                                   @bind="searchTerm"
                                   @oninput="OnInputChanged"
                                   placeholder="Search for a piece..."/>
                            
                            @if (showDropdown && MentionerPieces.Any())
                            {
                                <div class="combobox-dropdown">
                                    @foreach (var mentionerPiece in MentionerPieces)
                                    {
                                        <div class="combobox-item" 
                                             @onclick="() => SelectMentionerPiece(mentionerPiece)">
                                            @mentionerPiece?.Name
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <input type="hidden" @bind="formModel.MentionerPiece" />
                    </div>
                </div>
            </div>

            <div class="text-block">
                <div class="green-bar tall"></div>
                <div class="text-section tall" style="overflow: visible;">
                    <div class="form-group description-group">
                        <label>Description:</label>
                        <InputTextArea @bind-Value="formModel.Description" class="form-control description-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="main-container">
            <div class="image-container">
                <div class="image-border outer"></div>
                <div class="image-border inner"></div>
            </div> 
            
            <div class="analog-button-container">
                <button type="button" class="analog-button">+</button>
                <button type="button" class="analog-button">-</button>
            </div>        
            <InputTextArea @bind-Value="formModel.Image" class="form-control name-input" />
        </div>
    </div>

    <div class="button-container">
        <button type="submit" class="btn-submit">Submit</button>
    </div>
</EditForm>

@if (isModalVisible)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h2>⚡ Piece Created ⚡</h2>
            <p>The Piece will be approved by our staff</p>
            <button @onclick="CloseModal">
                OK
            </button>
        </div>
    </div>
}
@code {
    private FormMentionModel formModel = new();
    private bool isModalVisible;
    private bool showDropdown;
    private string searchTerm = "";
    private List<PieceComboboxDto?> MentionerPieces = new();

    private void OnInputChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        _ = OnSearchChanged(); // Chama o método assíncrono
    }

    private async Task OnSearchChanged()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm) && searchTerm.Length >= 2)
        {
            MentionerPieces = await MentionService.GetMentionByNameAsync(searchTerm);
            showDropdown = true;
        }
        else
        {
            MentionerPieces.Clear();
            showDropdown = false;
        }
        StateHasChanged();
    }

    private void SelectMentionerPiece(PieceComboboxDto? selected)
    {
        if (selected is null) return;

        formModel.MentionerPiece = selected.Id;
        searchTerm = selected.Name;
        showDropdown = false;
        StateHasChanged();
    }

    private void CloseModal()
    {
        isModalVisible = false;
        formModel = new();
        StateHasChanged();
    }

    [Parameter]
    public EventCallback<FormMentionModel> OnSubmit { get; set; }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(formModel);
    }

    public async Task ShowSuccessModal()
    {
        isModalVisible = true;
        StateHasChanged();
        
        await Task.Delay(3000);
        CloseModal();
    }
}