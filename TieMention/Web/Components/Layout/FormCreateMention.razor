@rendermode InteractiveServer
@inject MentionService MentionService

<EditForm Model="@formModel" OnValidSubmit="HandleSubmit" FormName="mention-form">
    <div class="main-content">
        <div class="text-content">
            <div class="text-block preserve-line-breaks">
                <div class="green-bar"></div>
                <div class="text-section" style="overflow: visible;">
                    <div class="form-group">
                        <label>Mentioner Piece:</label>
                        <div class="combobox-container">
                            <input type="text"
                                   class="form-control"
                                   style="background-color: black; border: 1px solid #333;"
                                   @bind="mentionerSearchTerm"
                                   @oninput="OnMentionerInputChanged"
                                   placeholder="Search for a piece..." />

                            @if (showMentionerDropdown && MentionerPieces.Any())
                            {
                                <div class="combobox-dropdown">
                                    @foreach (var mentionerPiece in MentionerPieces)
                                    {
                                        <div class="combobox-item"
                                             @onclick="() => SelectMentionerPiece(mentionerPiece)">
                                            @mentionerPiece?.Name
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <input type="hidden" @bind="formModel.MentionerPieceId" />
                    </div>

                    <div class="form-group">
                        <label>Mentioned Piece:</label>
                        @if (MentionedPieceId.HasValue)
                        {
                            <input type="text"
                                   class="form-control"
                                   style="background-color: black; border: 1px solid #333;"
                                   value="@MentionedPieceName"
                                   disabled />
                        }
                        else
                        {
                            <div class="combobox-container">
                                <input type="text"
                                       class="form-control"
                                       style="background-color: black; border: 1px solid #333;"
                                       @bind="mentionedSearchTerm"
                                       @oninput="OnMentionedInputChanged"
                                       placeholder="Search for a piece..." />

                                @if (showMentionedDropdown && MentionedPieces.Any())
                                {
                                    <div class="combobox-dropdown">
                                        @foreach (var mentionedPiece in MentionedPieces)
                                        {
                                            <div class="combobox-item"
                                                 @onclick="() => SelectMentionedPiece(mentionedPiece)">
                                                @mentionedPiece?.Name
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <input type="hidden" @bind="formModel.MentionedPieceId" />
                    </div>
                </div>
            </div>

            <div class="text-block">
                <div class="green-bar tall"></div>
                <div class="text-section tall" style="overflow: visible;">
                    <div class="form-group description-group">
                        <label>Description:</label>
                        <InputTextArea @bind-Value="formModel.Description" class="form-control description-input" />
                    </div>
                </div>
            </div>
        </div>

        <div class="main-container">
            <div class="image-container">
                <div class="image-border outer"></div>
                <div class="image-border inner"></div>
            </div>

            <div class="analog-button-container">
                <button type="button" class="analog-button">+</button>
                <button type="button" class="analog-button">-</button>
            </div>
            <InputTextArea @bind-Value="formModel.Image" class="form-control name-input" />
        </div>
    </div>

    <div class="button-container">
        <button type="submit" class="btn-submit">Submit</button>
    </div>
</EditForm>

@if (isModalVisible)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h2>Mention Created</h2>
            <p>The mention will be approved by our staff</p>
            <button @onclick="CloseModal">
                OK
            </button>
        </div>
    </div>
}

@code {
    private FormMentionModel formModel = new();
    private bool isModalVisible;
    private bool showMentionerDropdown;
    private bool showMentionedDropdown;
    private string mentionerSearchTerm = "";
    private string mentionedSearchTerm = "";
    private List<PieceComboboxDto?> MentionerPieces = new();
    private List<PieceComboboxDto?> MentionedPieces = new();

    [Parameter]
    public Guid? MentionedPieceId { get; set; }

    [Parameter]
    public string? MentionedPieceName { get; set; }

    [Parameter]
    public EventCallback<FormMentionModel> OnSubmit { get; set; }

    protected override void OnParametersSet()
    {
        ApplyMentionedPieceContext();
    }

    private void ApplyMentionedPieceContext()
    {
        if (MentionedPieceId.HasValue)
        {
            formModel.MentionedPieceId = MentionedPieceId;
            mentionedSearchTerm = MentionedPieceName ?? "";
        }
    }

    private void OnMentionerInputChanged(ChangeEventArgs e)
    {
        mentionerSearchTerm = e.Value?.ToString() ?? "";
        _ = OnMentionerSearchChanged();
    }

    private async Task OnMentionerSearchChanged()
    {
        if (!string.IsNullOrWhiteSpace(mentionerSearchTerm) && mentionerSearchTerm.Length >= 2)
        {
            MentionerPieces = await MentionService.GetMentionByNameAsync(mentionerSearchTerm) ?? new();
            showMentionerDropdown = true;
        }
        else
        {
            MentionerPieces.Clear();
            showMentionerDropdown = false;
        }

        StateHasChanged();
    }

    private void OnMentionedInputChanged(ChangeEventArgs e)
    {
        mentionedSearchTerm = e.Value?.ToString() ?? "";
        _ = OnMentionedSearchChanged();
    }

    private async Task OnMentionedSearchChanged()
    {
        if (!string.IsNullOrWhiteSpace(mentionedSearchTerm) && mentionedSearchTerm.Length >= 2)
        {
            MentionedPieces = await MentionService.GetMentionByNameAsync(mentionedSearchTerm) ?? new();
            showMentionedDropdown = true;
        }
        else
        {
            MentionedPieces.Clear();
            showMentionedDropdown = false;
        }

        StateHasChanged();
    }

    private void SelectMentionerPiece(PieceComboboxDto? selected)
    {
        if (selected is null) return;

        formModel.MentionerPieceId = selected.Id;
        mentionerSearchTerm = selected.Name;
        showMentionerDropdown = false;
        StateHasChanged();
    }

    private void SelectMentionedPiece(PieceComboboxDto? selected)
    {
        if (selected is null) return;

        formModel.MentionedPieceId = selected.Id;
        mentionedSearchTerm = selected.Name;
        showMentionedDropdown = false;
        StateHasChanged();
    }

    private void CloseModal()
    {
        isModalVisible = false;
        formModel = new();
        ApplyMentionedPieceContext();
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync(formModel);
    }

    public async Task ShowSuccessModal()
    {
        isModalVisible = true;
        StateHasChanged();

        await Task.Delay(3000);
        CloseModal();
    }
}
