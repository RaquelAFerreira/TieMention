@rendermode InteractiveServer
@using TieMention.Services
@inject PieceService PieceService
@inject NavigationManager Navigation

<div class="search-container">
    <i @onclick="LoadPieces" class="fa fa-search"></i>
    <input @bind="SearchTerm" 
           @onkeypress="HandleKeyPress"
           @bind:event="oninput"
           type="text" 
           placeholder="Search for mentions" 
           class="search-input">
    @* <button @onclick="LoadPieces">Search</button> *@
</div>

@code {
    private string SearchTerm { get; set; } = string.Empty;

    private async Task LoadPieces()
    {
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            Navigation.NavigateTo("/list/" + SearchTerm.Trim());
        }
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            LoadPieces();
        }
    }
}