@rendermode InteractiveServer
@using TieMention.Services
@inject PieceService PieceService
@inject NavigationManager Navigation

<div class="search-container">
    <i @onclick="LoadPieces" class="fa fa-search"></i> 
    <input @bind="SearchTerm"  type="text" placeholder="Search for mentions" class="search-input">
    <button @onclick="LoadPieces">Search</button>
</div>

@code {
    private string SearchTerm { get; set; } = string.Empty;

    private async Task LoadPieces()
    {
        Navigation.NavigateTo("/list/"+SearchTerm);
    }

}
