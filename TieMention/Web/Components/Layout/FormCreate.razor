@rendermode InteractiveServer

<EditForm Model="@formModel" OnValidSubmit="HandleSubmit" FormName="plain-form">
    <div class="main-content">
        <div class="text-content">
            <div class="text-block preserve-line-breaks">
                <div class="green-bar"></div>
                <div class="text-section">
                    <div class="form-group">
                        <InputSelect @bind-Value="formModel.Category" class="form-control" style="background-color: black; border: 1px solid #333;">
                            <option value="">Category</option>
                            <option value="Movie">Movie</option>
                            <option value="TV Show">TV Show</option>
                            <option value="Documentary">Documentary</option>
                            <option value="Animation">Animation</option>
                            <option value="Short Film">Short Film</option>
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <InputSelect @bind-Value="formModel.ReleaseYear" class="form-control" style="background-color: black; border: 1px solid #333;">
                            <option value="">Release Year</option>
                            @foreach (var year in availableYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </InputSelect>
                    </div>
                </div>
            </div>

            <div class="text-block">
                <div class="green-bar tall"></div>
                <div class="text-section tall">
                    <div class="form-group description-group">
                        <label>Name:</label>
                        <InputTextArea @bind-Value="formModel.Name" class="form-control name-input" style="background-color: black; border: 1px solid #74a814;" />

                        <label>Description:</label>
                        <InputTextArea @bind-Value="formModel.Description" class="form-control description-input" style="height: 290px; background-color: black; border: 1px solid #74a814;" />
                    </div>
                </div>
            </div>
        </div>

        <div class="main-container">
            <div class="image-container">
                <div class="image-border outer"></div>
                <div class="image-border inner"></div>
                @* <img src="@formModel.Image" class="main-image"> *@
            </div> 
            
            <div class="analog-button-container">
                <button type="button" class="analog-button">+</button>
                <button type="button" class="analog-button">-</button>
            </div>        
            <InputTextArea @bind-Value="formModel.Image" class="form-control name-input"  style="background-color: black; border: 1px solid #74a814;" />
        </div>
    </div>

    <div class="button-container">
        <button type="submit" class="btn-submit">Submit</button>
    </div>
</EditForm>

@code {
    private FormModel formModel = new();
    private List<int> availableYears = new();

    [Parameter] public EventCallback<string?> Category { get; set; }
    [Parameter] public EventCallback<string?> ReleaseYear { get; set; }
    [Parameter] public EventCallback<string?> Description { get; set; }
    [Parameter] public EventCallback<string?> Name { get; set; }
    [Parameter] public EventCallback<string?> Image { get; set; }

    private async Task HandleSubmit()
    {
        await Image.InvokeAsync(formModel.Image);
        await Name.InvokeAsync(formModel.Name);
        await Category.InvokeAsync(formModel.Category);
        await ReleaseYear.InvokeAsync(formModel.ReleaseYear);
        await Description.InvokeAsync(formModel.Description);
    }

    protected override void OnInitialized()
    {
        int currentYear = DateTime.Now.Year;
        for (int year = currentYear; year >= currentYear - 120; year--)
        {
            availableYears.Add(year);
        }
    }

    private class FormModel
    {
        public string? Image { get; set; }
        public string? Name { get; set; }
        public string? Category { get; set; }
        public string? ReleaseYear { get; set; }
        public string? Description { get; set; }
    }
}
