<div class="main-container">
    <div class="image-container">
        <div class="image-border outer"></div>
        <div class="image-border inner"></div>
        <video width="800" height="450" controls autoplay muted loop poster="@Thumb"> 
            <source src="http://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4" type="video/mp4">
        </video>
    </div> 
    
    <div class="analog-button-container">
        <button class="analog-button">+</button>
        <button class="analog-button">-</button>
        <button class="analog-button">:</button>
        <button class="analog-button">:</button>
        <button class="analog-button">:</button>
    </div>
</div>


@code {
    [Parameter]
    public String? Video {get; set;}

    public String? Thumb {get; set;}

}